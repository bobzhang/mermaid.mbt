///|
test "atan2 matches V8" {
  let mut bad = 0
  for case in atan2_cases {
    let a = case.0.reinterpret_as_double()
    let b = case.1.reinterpret_as_double()
    if @jsmath.atan2(a, b).reinterpret_as_int64() != case.2 {
      bad += 1
    }
  }
  inspect(bad, content="0")
}

