///|
test "acos matches V8" {
  let mut bad = 0
  for case in acos_cases {
    let x = case.0.reinterpret_as_double()
    if @jsmath.acos(x).reinterpret_as_int64() != case.1 {
      bad += 1
    }
  }
  inspect(bad, content="0")
}

