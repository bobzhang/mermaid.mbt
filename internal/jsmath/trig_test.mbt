///|
test "cos matches V8" {
  let mut bad = 0
  for case in cos_cases {
    let x = case.0.reinterpret_as_double()
    if @jsmath.cos(x).reinterpret_as_int64() != case.1 {
      bad += 1
    }
  }
  inspect(bad, content="0")
}

///|
test "special values" {
  inspect(@jsmath.sin(0.0), content="0")
  inspect(1.0 / @jsmath.sin(-0.0), content="-Infinity")
  inspect(@jsmath.cos(0.0), content="1")
  inspect(@jsmath.sin(1.0 / 0.0), content="NaN")
  inspect(@jsmath.cos(-1.0 / 0.0), content="NaN")
  inspect(@jsmath.sin(0.0 / 0.0), content="NaN")
  inspect(@jsmath.sin(1.0e-10), content="1e-10")
  inspect(@jsmath.sin(3.141592653589793), content="1.2246467991473532e-16")
  inspect(@jsmath.cos(1.5707963267948966), content="6.123233995736766e-17")
}
