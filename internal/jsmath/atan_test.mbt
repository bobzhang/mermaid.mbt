///|
test "atan matches Chrome bit for bit" {
  let mut wrong = 0
  for case in atan_cases {
    let x = case.0.reinterpret_as_double()
    if @jsmath.atan(x).reinterpret_as_int64() != case.1 {
      wrong += 1
    }
  }
  inspect(wrong, content="0")
}
