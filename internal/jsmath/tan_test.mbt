///|
test "tan is correctly rounded, as in V8" {
  let mut wrong = 0
  for sample in tan_samples {
    let x = sample.0.reinterpret_as_double()
    if @jsmath.tan(x).reinterpret_as_uint64() != sample.1 {
      wrong += 1
    }
  }
  inspect(wrong, content="0")
}
