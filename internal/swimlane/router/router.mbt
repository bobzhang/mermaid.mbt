// The orthogonal edge router: `swimlanes/orthogonalRouter/router.ts`.

///|
/// Route every drawn edge of the layout orthogonally between its nodes:
/// `routeEdgesOrthogonal`. Sets `points` of the layout's edges.
pub fn route_edges_orthogonal(
  layout : @model.Layout,
  direction : String,
) -> Unit {
  ignore(layout)
  ignore(direction)
  abort("routeEdgesOrthogonal is not ported yet")
}
