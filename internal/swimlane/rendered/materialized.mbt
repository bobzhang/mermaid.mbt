// Clean-ups of the routes as they will be drawn: `swimlanes/direction/materializedGeometry.ts`.

///|
/// `separateSharedRenderedTerminalLanes`.
pub fn separate_shared_rendered_terminal_lanes(
  edges : Array[@model.Edge],
  node_by_id : Map[String, @model.Node],
) -> Unit {
  ignore(edges)
  ignore(node_by_id)
  abort("separateSharedRenderedTerminalLanes is not ported yet")
}

