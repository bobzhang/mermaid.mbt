///|
/// Whether `name` is a shape nodes can ask for.
pub fn is_valid_shape(name : String) -> Bool {
  shape_handlers.contains(name)
}

///|
/// The shape that draws nodes asking for `name`.
pub fn shape_handler(name : String) -> String? {
  shape_handlers.get(name)
}
