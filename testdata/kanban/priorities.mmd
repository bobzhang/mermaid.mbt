kanban
  a[Priorities]
    p1[Very high]@{ priority: 'Very High' }
    p2[High]@{ priority: High }
    p3[Medium]@{ priority: Medium }
    p4[Low]@{ priority: Low }
    p5[Very low]@{ priority: "Very Low" }
    p6[lower case]@{ priority: high }
    p7[number]@{ priority: 3 }
    p8[bool]@{ priority: true }
    p9[false]@{ priority: false }
    p10[zero]@{ priority: 0 }
    p11[null]@{ priority: null }
    p12[list]@{ priority: [High] }
