---
config:
  look: classic
  handDrawnSeed: 7
---
flowchart LR
    T@{ shape: tri, label: "Extract" } --> F@{ shape: flip-tri, label: "Manual file" }
    T --> P@{ shape: notch-pent, label: "Loop limit" }
    F --> S@{ shape: sl-rect, label: "Manual input" }
    P --> S
    S --> C@{ shape: curv-trap, label: "Display" }
    S --> D@{ shape: delay, label: "Delay" }
    C --> B@{ shape: bow-rect, label: "Stored data" }
    D --> B
    style P fill:#fdd,stroke:#900
    classDef hot fill:#ffd,stroke:#f80,stroke-width:2px,color:#333
    class T,S,C,B hot
    style F fill:#dfd,stroke:#090,stroke-dasharray: 4 2
    style D stroke-width:3px
