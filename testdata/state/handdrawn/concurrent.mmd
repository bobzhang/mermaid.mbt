---
config:
  look: handDrawn
  handDrawnSeed: 8
  theme: forest
---
stateDiagram-v2
  [*] --> Active
  state Active {
    [*] --> NumLockOff
    NumLockOff --> NumLockOn : EvNumLockPressed
    NumLockOn --> NumLockOff : EvNumLockPressed
    --
    [*] --> CapsLockOff
    CapsLockOff --> CapsLockOn : EvCapsLockPressed
    CapsLockOn --> CapsLockOff : EvCapsLockPressed
  }
  state fork_state <<fork>>
  [*] --> fork_state
  fork_state --> State2
  fork_state --> State3
  state join_state <<join>>
  State2 --> join_state
  State3 --> join_state
  join_state --> State4
  state if_state <<choice>>
  State4 --> if_state
  if_state --> False: if n < 0
  if_state --> True : if n >= 0
  classDef bad fill:#f00,color:white,font-weight:bold,stroke-width:2px,stroke:yellow
  class True bad
